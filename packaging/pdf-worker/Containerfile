ARG BASE_IMAGE=python:3.12.16-alpine3.24@sha256:5642cb13b1fc85462dec7ad9d954623a57fe1e65981e1508dff894942eaa8694
ARG DEPENDENCY_IMAGE=sha256:7a78eaf7ef812d354f0abe13f40c6c0a4e3684d94f72002245c5249249bf293b
FROM ${DEPENDENCY_IMAGE} AS dependencies
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
# Offline source refresh: exact dependency bytes from the immutable old image.
# That image's qualification does not qualify this rebuilt source image.
COPY --from=dependencies /usr/local /usr/local
COPY --chmod=0555 src /app/src

USER 65532:65532
ENTRYPOINT ["python", "-m", "redaction_lab.application.worker_protocol"]

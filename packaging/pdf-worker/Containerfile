ARG DEPENDENCY_IMAGE=sha256:698f1a601c9f0465ac425a81790cb68d5d978430ad73207feb579e200a11c3ff
FROM ${DEPENDENCY_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
# Offline source refresh from the immutable OCR/Python dependency image.
# That dependency image's qualification does not qualify this source image.
COPY --chmod=0555 src /app/src

USER 65532:65532
ENTRYPOINT ["python", "-m", "redaction_lab.application.worker_protocol"]

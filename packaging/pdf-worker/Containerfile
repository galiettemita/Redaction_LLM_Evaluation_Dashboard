ARG BASE_IMAGE=python:3.12.16-alpine3.24@sha256:5642cb13b1fc85462dec7ad9d954623a57fe1e65981e1508dff894942eaa8694
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY packaging/pdf-worker/requirements.lock /tmp/redaction-lab-requirements.lock
COPY packaging/pdf-worker/wheelhouse /wheelhouse
RUN python -m pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    --no-index \
    --find-links=/wheelhouse \
    --require-hashes \
    --requirement /tmp/redaction-lab-requirements.lock \
    && rm -rf /wheelhouse /tmp/redaction-lab-requirements.lock
COPY src /app/src

USER 65532:65532
ENTRYPOINT ["python", "-m", "redaction_lab.application.worker_protocol"]
